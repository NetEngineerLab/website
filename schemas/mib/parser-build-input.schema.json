{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netengineerlab.com/schemas/mib/parser-build-input/1.0.0",
  "title": "MIB/OID parser build input lock",
  "$defs": {
    "module-base": { "type": "object", "additionalProperties": false, "required": ["moduleName", "documentId", "sourceId", "acquisitionId", "reviewId", "artifactId", "contentSha256", "contentBytes", "importNames"], "properties": { "moduleName": { "type": "string" }, "documentId": { "type": "string", "minLength": 1 }, "sourceId": { "type": "string", "pattern": "^source-[0-9a-f]{64}$" }, "acquisitionId": { "type": "string", "pattern": "^acq-[0-9a-f]{64}$" }, "reviewId": { "type": "string", "pattern": "^review-[0-9a-f]{64}$" }, "artifactId": { "type": "string", "pattern": "^artifact-[0-9a-f]{64}$" }, "contentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "contentBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 }, "importNames": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } } },
    "module-smi": { "allOf": [ { "$ref": "#/$defs/module-base" }, { "properties": { "moduleName": { "const": "SNMPv2-SMI" } } } ] },
    "module-tc": { "allOf": [ { "$ref": "#/$defs/module-base" }, { "properties": { "moduleName": { "const": "SNMPv2-TC" } } } ] },
    "module-conf": { "allOf": [ { "$ref": "#/$defs/module-base" }, { "properties": { "moduleName": { "const": "SNMPv2-CONF" } } } ] },
    "module-mib": { "allOf": [ { "$ref": "#/$defs/module-base" }, { "properties": { "moduleName": { "const": "SNMPv2-MIB" } } } ] },
    "module-inet": { "allOf": [ { "$ref": "#/$defs/module-base" }, { "properties": { "moduleName": { "const": "INET-ADDRESS-MIB" } } } ] },
    "module-tcp": { "allOf": [ { "$ref": "#/$defs/module-base" }, { "properties": { "moduleName": { "const": "TCP-MIB" } } } ] },
    "module-udp": { "allOf": [ { "$ref": "#/$defs/module-base" }, { "properties": { "moduleName": { "const": "UDP-MIB" } } } ] },
    "module-framework": { "allOf": [ { "$ref": "#/$defs/module-base" }, { "properties": { "moduleName": { "const": "SNMP-FRAMEWORK-MIB" } } } ] }
  },
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "lockId", "createdAt", "createdBy", "sourceSnapshotId", "modules", "runtime", "goldenFixturePolicy", "lockHash"],
  "properties": {
    "schemaVersion": { "const": "parser-build-input/1.0.0" }, "lockId": { "type": "string", "pattern": "^lock-[0-9a-f]{64}$" }, "createdAt": { "type": "string", "format": "date-time" }, "createdBy": { "type": "string", "minLength": 1 }, "sourceSnapshotId": { "type": "string", "minLength": 1 },
    "modules": { "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "prefixItems": [ { "$ref": "#/$defs/module-smi" }, { "$ref": "#/$defs/module-tc" }, { "$ref": "#/$defs/module-conf" }, { "$ref": "#/$defs/module-mib" }, { "$ref": "#/$defs/module-inet" }, { "$ref": "#/$defs/module-tcp" }, { "$ref": "#/$defs/module-udp" }, { "$ref": "#/$defs/module-framework" } ], "items": false },
    "runtime": { "type": "object", "additionalProperties": false, "required": ["runtimeApprovalId", "runtimeImageDigest", "provenanceSha256", "inputLockSha256", "sbomSha256", "packageName", "packageVersion", "dependencyTreeSha256", "nodeVersion", "os", "architecture", "networkEnabled", "tempDirectoryPolicy", "resourceLimits"], "properties": { "runtimeApprovalId": { "type": "string", "pattern": "^runtimeapproval-[0-9a-f]{64}$" }, "runtimeImageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "provenanceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "inputLockSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "sbomSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "packageName": { "type": "string", "minLength": 1 }, "packageVersion": { "type": "string", "minLength": 1 }, "dependencyTreeSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "nodeVersion": { "type": "string", "minLength": 1 }, "os": { "const": "linux" }, "architecture": { "const": "amd64" }, "networkEnabled": { "const": false }, "tempDirectoryPolicy": { "enum": ["exclusive-create-private-cleanup", "disabled"] }, "resourceLimits": { "type": "object", "additionalProperties": false, "required": ["inputBytes", "moduleCount", "importDepth", "astNodes", "cpuMs", "memoryBytes", "outputBytes", "tempBytes"], "properties": { "inputBytes": { "type": "integer", "minimum": 1 }, "moduleCount": { "type": "integer", "minimum": 1 }, "importDepth": { "type": "integer", "minimum": 1 }, "astNodes": { "type": "integer", "minimum": 1 }, "cpuMs": { "type": "integer", "minimum": 1 }, "memoryBytes": { "type": "integer", "minimum": 1 }, "outputBytes": { "type": "integer", "minimum": 1 }, "tempBytes": { "type": "integer", "minimum": 1 } } } } },
    "goldenFixturePolicy": { "type": "object", "additionalProperties": false, "required": ["allowedKinds", "requiresSourceBinding", "fixtures"], "properties": { "allowedKinds": { "type": "array", "minItems": 1, "items": { "enum": ["synthetic-fault", "approved-standard-module"] }, "uniqueItems": true }, "requiresSourceBinding": { "const": true }, "fixtures": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["fixtureId", "kind", "parserVersion", "sourceId", "artifactId", "expectedOutcome"], "properties": { "fixtureId": { "type": "string", "minLength": 1 }, "kind": { "enum": ["synthetic-fault", "approved-standard-module"] }, "parserVersion": { "type": "string", "minLength": 1 }, "sourceId": { "type": "string", "pattern": "^source-[0-9a-f]{64}$" }, "artifactId": { "type": "string", "pattern": "^artifact-[0-9a-f]{64}$" }, "expectedOutcome": { "type": "string", "minLength": 1 } } }, "minItems": 1, "uniqueItems": true } } },
    "lockHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
