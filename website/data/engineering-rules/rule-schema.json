{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netengineerlab.com/schemas/engineering-rule-1.0.0.json",
  "title": "NetEngineerLab Engineering Rule",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "status", "domain", "category", "severity", "dimensions", "condition", "content", "vendors", "sourceTypes", "evidence", "references", "fixtures"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "active", "deprecated"]},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "category": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "severity": {"enum": ["CRITICAL", "HIGH", "MEDIUM", "INFO"]},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["connectivity", "security", "reliability", "manageability", "best-practice"]}
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operator", "params"],
      "properties": {
        "operator": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "params": {"type": "object"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": {"$ref": "#/$defs/localizedContent"},
        "zh": {"$ref": "#/$defs/localizedContent"}
      }
    },
    "vendors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "sourceTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["parameters", "configuration", "command-output"]}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector", "fields", "redactions"],
      "properties": {
        "selector": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "redactions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"}
        }
      }
    },
    "fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative", "boundary"],
      "properties": {
        "positive": {"$ref": "#/$defs/fixtureList"},
        "negative": {"$ref": "#/$defs/fixtureList"},
        "boundary": {"$ref": "#/$defs/fixtureList"}
      }
    }
  },
  "$defs": {
    "localizedContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "finding", "reason", "recommendation", "fieldExperienceNote"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "finding": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "fieldExperienceNote": {"type": "string", "minLength": 1}
      }
    },
    "fixtureList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[a-zA-Z0-9][a-zA-Z0-9._/-]*\\.json$"}
    }
  }
}
