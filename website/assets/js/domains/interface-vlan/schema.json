{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netengineerlab.com/schema/interface-vlan-v1.json",
  "title": "NetEngineerLab Interface/VLAN Canonical Domain Model V1",
  "type": "object",
  "required": ["name", "mode"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "mode": {"enum": ["access", "trunk"]},
    "accessVlan": {"type": "integer", "minimum": 1, "maximum": 4094},
    "allowedVlans": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4094}},
    "nativeVlan": {"type": ["integer", "null"], "minimum": 1, "maximum": 4094}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "access"}}}, "then": {"required": ["accessVlan"]}},
    {"if": {"properties": {"mode": {"const": "trunk"}}}, "then": {"required": ["allowedVlans"]}}
  ],
  "additionalProperties": true
}
