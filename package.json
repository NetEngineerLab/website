{
  "name": "netengineerlab-production-launch-acceptance",
  "private": true,
  "version": "1.9.9-04-p0-p1-correctness-consent-offline",
  "description": "Production launch, online availability, and Lighthouse performance monitoring for NetEngineerLab.",
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "build:i18n": "npm run build:config && node scripts/build-multilingual.js",
    "validate:architecture": "node scripts/architecture-validate.js",
    "validate:i18n": "node scripts/validate-multilingual.js",
    "scaffold:locale": "node scripts/scaffold-locale.js",
    "build": "npm run build:i18n",
    "audit:launch": "node scripts/launch-audit.js",
    "audit:seo": "node scripts/seo-content-audit.js",
    "audit:seo-geo": "node scripts/seo-geo-coverage-audit.js",
    "test:seo-schema": "node scripts/schema-walk-test.js",
    "test:seo-geo": "node scripts/seo-geo-coverage-test.js",
    "test:rules-contract": "node scripts/engineering-rules-contract-test.js",
    "test:rules-runtime": "node scripts/engineering-rules-runtime-test.js",
    "test:acl-core": "node website/tools/acl-generator-validator/docs/engine-test.js",
    "test:acl-rules": "node scripts/acl-rules-test.js",
    "test:sw-precache": "node scripts/service-worker-precache-test.js",
    "prepare:launch": "npm run build:i18n && npm run test:ga4 && npm run test:ga4-online && npm run validate:i18n && npm run validate:architecture && npm run test:rules-contract && npm run test:rules-runtime && npm run test:acl-core && npm run test:acl-rules && npm run test:sw-precache && npm run audit:launch && npm run audit:seo && npm run test:seo-schema && npm run audit:seo-geo && npm run test:seo-geo && npm run test:online-revalidation && npm run test:performance-monitor && npm run accept:production && npm run release:manifest",
    "preview": "node scripts/preview-server.js",
    "build:config": "npm run version:sync && node scripts/build-site-config.js && npm run build:rules",
    "build:rules": "node scripts/build-rules-bundle.js",
    "accept:production": "node scripts/production-acceptance.js",
    "accept:remote": "node scripts/remote-acceptance.js",
    "check:online": "node scripts/production-online-check.js",
    "test:online-revalidation": "node scripts/production-online-revalidation-test.js",
    "report:performance": "node scripts/production-performance-report.js",
    "test:performance-monitor": "node scripts/production-performance-test.js",
    "release:manifest": "node scripts/release-manifest.js",
    "test:sfp-qsfp": "node website/tools/sfp-qsfp-compatibility-calculator/docs/engine-test.js",
    "test:ga4": "node scripts/ga4-config-test.js",
