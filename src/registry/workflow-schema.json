{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netengineerlab.com/schema/workflow-v2.1.json",
  "title": "NetEngineerLab Workflow Schema V2.1",
  "type": "object",
  "required": ["id", "schemaVersion", "status", "domain", "translations", "steps"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "schemaVersion": {"const":"2.1.0"},
    "status": {"enum":["active","planned","retired"]},
    "domain": {"type":"string"},
    "primary": {"type":"boolean"},
    "translations": {
      "type":"object",
      "required":["en","zh"],
      "properties": {
        "en":{"$ref":"#/$defs/copy"},
        "zh":{"$ref":"#/$defs/copy"}
      }
    },
    "steps": {
      "type":"array",
      "minItems":2,
      "items": {
        "type":"object",
        "required":["order","toolId","translations"],
        "properties": {
          "order":{"type":"integer","minimum":1},
          "toolId":{"type":"string"},
          "translations": {
            "type":"object",
            "required":["en","zh"],
            "properties": {
              "en":{"$ref":"#/$defs/stepCopy"},
              "zh":{"$ref":"#/$defs/stepCopy"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "copy": {
      "type":"object",
      "required":["name","description"],
      "properties": {
        "name":{"type":"string","minLength":1},
        "description":{"type":"string","minLength":1}
      }
    },
    "stepCopy": {
      "type":"object",
      "required":["action"],
      "properties": {"action":{"type":"string","minLength":1}}
    }
  }
}
