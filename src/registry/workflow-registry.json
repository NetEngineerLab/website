[
  {
    "id": "optical-link-design",
    "schemaVersion": "2.1.0",
    "status": "active",
    "domain": "optical",
    "primary": true,
    "translations": {
      "en": {
        "name": "Optical Link Design Workflow",
        "description": "Build an optical link from physical loss assumptions through split planning, power budget and maximum reach verification."
      },
      "zh": {
        "name": "光链路设计工作流",
        "description": "从物理损耗、分光规划到光功率预算和最大距离验证，完成一条光链路的设计闭环。"
      }
    },
    "steps": [
      {
        "order": 1,
        "toolId": "fiber-loss",
        "translations": {
          "en": {
            "action": "Model physical and engineering loss"
          },
          "zh": {
            "action": "计算物理损耗与工程余量"
          }
        }
      },
      {
        "order": 2,
        "toolId": "pon-splitter-loss",
        "translations": {
          "en": {
            "action": "Plan splitter stages and insertion loss"
          },
          "zh": {
            "action": "规划分光级联与插入损耗"
          }
        }
      },
      {
        "order": 3,
        "toolId": "optical-power-budget",
        "translations": {
          "en": {
            "action": "Validate end-to-end optical margin"
          },
          "zh": {
            "action": "验证端到端光功率余量"
          }
        }
      },
      {
        "order": 4,
        "toolId": "pon-distance",
        "translations": {
          "en": {
            "action": "Check effective system reach"
          },
          "zh": {
            "action": "核验系统有效传输距离"
          }
        }
      }
    ]
  },
  {
    "id": "optical-troubleshooting",
    "schemaVersion": "2.1.0",
    "status": "active",
    "domain": "operations",
    "primary": true,
    "translations": {
      "en": {
        "name": "Optical Fault Isolation Workflow",
        "description": "Start from measured ONU receive power, locate abnormal events, then compare field loss with the design budget."
      },
      "zh": {
        "name": "光网络故障定位工作流",
        "description": "从 ONU 实测接收光功率入手，定位异常事件，再与设计损耗和预算进行交叉验证。"
      }
    },
    "steps": [
      {
        "order": 1,
        "toolId": "onu-rx-power",
        "translations": {
          "en": {
            "action": "Classify measured receive-power health"
          },
          "zh": {
            "action": "判断实测接收光功率健康状态"
          }
        }
      },
      {
        "order": 2,
        "toolId": "otdr-event",
        "translations": {
          "en": {
            "action": "Locate and classify optical events"
          },
          "zh": {
            "action": "定位并分类 OTDR 光事件"
          }
        }
      },
      {
        "order": 3,
        "toolId": "fiber-loss",
        "translations": {
          "en": {
            "action": "Reconstruct expected path loss"
          },
          "zh": {
            "action": "重建链路理论损耗"
          }
        }
      },
      {
        "order": 4,
        "toolId": "optical-power-budget",
        "translations": {
          "en": {
            "action": "Confirm remaining optical margin"
          },
          "zh": {
            "action": "确认剩余光功率余量"
          }
        }
      }
    ]
  },
  {
    "id": "enterprise-lan-ip-planning",
    "schemaVersion": "2.1.0",
    "status": "active",
    "domain": "ip-networking",
    "primary": true,
    "translations": {
      "en": {
        "name": "Enterprise LAN & IP Planning Workflow",
        "description": "Plan addressing, VLAN capacity, packet size, uplinks, optics, access policy and DNS behavior as one LAN design sequence."
      },
      "zh": {
        "name": "企业 LAN 与 IP 规划工作流",
        "description": "把地址规划、VLAN 容量、MTU、上联、光模块、访问策略和 DNS 行为串成完整局域网设计流程。"
      }
    },
    "steps": [
      {
        "order": 1,
        "toolId": "subnet-calculator",
        "translations": {
          "en": {
            "action": "Define IPv4 subnet boundaries"
          },
          "zh": {
            "action": "确定 IPv4 子网边界"
          }
        }
      },
      {
        "order": 2,
        "toolId": "ipv6-nat-planner",
        "translations": {
          "en": {
            "action": "Plan IPv6 prefixes and translation boundaries"
          },
          "zh": {
            "action": "规划 IPv6 前缀与地址转换边界"
          }
        }
      },
      {
        "order": 3,
        "toolId": "vlan-ip-capacity-planner",
        "translations": {
          "en": {
            "action": "Size VLAN and address capacity"
          },
          "zh": {
            "action": "核算 VLAN 与地址容量"
          }
        }
      },
      {
        "order": 4,
        "toolId": "mtu-calculator",
        "translations": {
          "en": {
            "action": "Validate MTU and MSS"
          },
          "zh": {
            "action": "验证 MTU 与 MSS"
          }
        }
      },
      {
        "order": 5,
        "toolId": "bandwidth-calculator",
        "translations": {
          "en": {
            "action": "Estimate traffic transfer requirements"
          },
          "zh": {
            "action": "估算带宽与传输时间需求"
          }
        }
      },
      {
        "order": 6,
        "toolId": "switch-uplink-oversubscription-calculator",
        "translations": {
          "en": {
            "action": "Size uplink bandwidth and oversubscription"
          },
          "zh": {
            "action": "核算交换机上联带宽与超售比"
          }
        }
      },
      {
        "order": 7,
        "toolId": "sfp-qsfp-compatibility-calculator",
        "translations": {
          "en": {
            "action": "Validate uplink optic compatibility"
          },
          "zh": {
            "action": "验证上联光模块兼容性"
          }
        }
      },
      {
        "order": 8,
        "toolId": "acl-generator-validator",
        "translations": {
          "en": {
            "action": "Generate and validate access policy"
          },
          "zh": {
            "action": "生成并验证访问控制策略"
          }
        }
      },
      {
        "order": 9,
        "toolId": "dns-ttl-propagation-calculator",
        "translations": {
          "en": {
            "action": "Plan DNS TTL and propagation behavior"
          },
          "zh": {
            "action": "规划 DNS TTL 与传播时间"
          }
        }
      }
    ]
  },
  {
    "id": "poe-rack-power-design",
    "schemaVersion": "2.1.0",
    "status": "active",
    "domain": "power-datacenter",
    "primary": true,
    "translations": {
      "en": {
        "name": "PoE & Rack Power Design Workflow",
        "description": "Verify PoE source capacity, cable voltage delivery, rack power and cooling, then estimate telecom battery backup runtime."
      },
      "zh": {
        "name": "PoE 与机架供电设计工作流",
        "description": "依次验证 PoE 供电容量、线缆压降、机架功耗与制冷，并估算通信电池后备时长。"
      }
    },
    "steps": [
      {
        "order": 1,
        "toolId": "poe-power-budget-calculator",
        "translations": {
          "en": {
            "action": "Check PSE power capacity"
          },
          "zh": {
            "action": "核验 PSE 供电容量"
          }
        }
      },
      {
        "order": 2,
        "toolId": "poe-voltage-drop-calculator",
        "translations": {
          "en": {
            "action": "Verify delivered voltage at cable length"
          },
          "zh": {
            "action": "验证线缆长度下的末端供电电压"
          }
        }
      },
      {
        "order": 3,
        "toolId": "network-rack-power-cooling-calculator",
        "translations": {
          "en": {
            "action": "Size rack power and cooling load"
          },
          "zh": {
            "action": "核算机架功耗与制冷负荷"
          }
        }
      },
      {
        "order": 4,
        "toolId": "48v-battery-runtime",
        "translations": {
          "en": {
            "action": "Estimate -48V backup runtime"
          },
          "zh": {
            "action": "估算 -48V 后备电池续航"
          }
        }
      }
    ]
  },
  {
    "id": "wireless-access-deployment",
    "schemaVersion": "2.1.0",
    "status": "active",
    "domain": "wireless",
    "primary": true,
    "translations": {
      "en": {
        "name": "Wireless Access Deployment Workflow",
        "description": "Estimate Wi-Fi coverage and client capacity, verify RF link margin, then validate PoE delivery and access-switch uplink capacity."
      },
      "zh": {
        "name": "无线接入部署工作流",
        "description": "先估算 Wi-Fi 覆盖与容量，再验证无线链路余量，最后核验 AP 的 PoE 供电和接入交换机上联能力。"
      }
    },
    "steps": [
      {
        "order": 1,
        "toolId": "wifi-coverage-capacity-planner",
        "translations": {
          "en": {
            "action": "Estimate AP count, coverage and client capacity"
          },
          "zh": {
            "action": "估算 AP 数量、覆盖与终端容量"
          }
        }
      },
      {
        "order": 2,
        "toolId": "wireless-link-budget-calculator",
        "translations": {
          "en": {
            "action": "Validate RF link budget and fade margin"
          },
          "zh": {
            "action": "验证无线链路预算与衰落余量"
          }
        }
      },
      {
        "order": 3,
        "toolId": "poe-power-budget-calculator",
        "translations": {
          "en": {
            "action": "Check aggregate AP PoE demand"
          },
          "zh": {
            "action": "核验 AP 总体 PoE 功耗需求"
          }
        }
      },
      {
        "order": 4,
        "toolId": "poe-voltage-drop-calculator",
        "translations": {
          "en": {
            "action": "Check long-cable AP voltage delivery"
          },
          "zh": {
            "action": "检查长距离网线的 AP 供电电压"
          }
        }
      },
      {
        "order": 5,
        "toolId": "switch-uplink-oversubscription-calculator",
        "translations": {
          "en": {
            "action": "Validate access-switch uplink headroom"
          },
          "zh": {
            "action": "验证接入交换机上联余量"
          }
        }
      }
    ]
  },
  {
    "id": "network-change-automation",
    "schemaVersion": "2.1.0",
    "status": "active",
    "domain": "operations",
    "primary": true,
    "translations": {
      "en": {
        "name": "Network Change Automation Workflow",
        "description": "Validate policy intent, then turn current device state and desired LAG/VLAN changes into a risk-scored, verifiable and reversible MOP."
      },
      "zh": {
        "name": "网络变更自动化工作流",
        "description": "先验证访问策略，再把设备当前状态与LAG/VLAN目标变更转化为带风险评分、验证步骤和回退方案的MOP。"
      }
    },
    "steps": [
      {
        "order": 1,
        "toolId": "acl-generator-validator",
        "translations": {
          "en": {
            "action": "Validate access-policy configuration before change"
          },
          "zh": {
            "action": "变更前验证访问控制策略"
          }
        }
      },
      {
        "order": 2,
        "toolId": "network-change-planner-mop-generator",
        "translations": {
          "en": {
            "action": "Plan, risk-score, execute and verify the network change"
          },
          "zh": {
            "action": "规划、评估、执行并验证网络变更"
          }
        }
      }
    ]
  },
  {
    "id": "telecom-power-energy",
    "schemaVersion": "2.1.0",
    "status": "active",
    "domain": "power-datacenter",
    "primary": true,
    "translations": {
      "en": {
        "name": "Telecom Power & Energy Workflow",
        "description": "Move from site load through AC/DC distribution, rectifier sizing and operating diagnostics, battery backup, generator fuel, solar generation and facility efficiency as one energy engineering sequence."
      },
      "zh": {
        "name": "通信电源与能源工作流",
        "description": "把站点负载、AC/DC配电、整流容量与运行诊断、后备电池、油机保障、光伏供能与设施能效串成完整能源工程流程。"
      }
    },
    "steps": [
      {
        "order": 1,
        "toolId": "network-rack-power-cooling-calculator",
        "translations": {
          "en": {
            "action": "Establish rack/site power and cooling load"
          },
          "zh": {
            "action": "确定机架/站点功耗与制冷负荷"
          }
        }
      },
      {
        "order": 2,
        "toolId": "telecom-ac-dc-breaker-sizing",
        "translations": {
          "en": {
            "action": "Size AC/DC feeders and protective-device planning current"
          },
          "zh": {
            "action": "核算AC/DC馈电与保护器件规划电流"
          }
        }
      },
      {
        "order": 3,
        "toolId": "telecom-rectifier-dc-power-sizing",
        "translations": {
          "en": {
            "action": "Size rectifier capacity and redundancy"
          },
          "zh": {
            "action": "配置整流模块容量与冗余"
          }
        }
      },
      {
        "order": 4,
        "toolId": "dc-plant-efficiency-load-sharing",
        "translations": {
          "en": {
            "action": "Diagnose rectifier load sharing and DC conversion efficiency"
          },
          "zh": {
            "action": "诊断整流模块均流与直流转换效率"
          }
        }
      },
      {
        "order": 5,
        "toolId": "48v-battery-runtime",
        "translations": {
          "en": {
            "action": "Size -48V backup autonomy"
          },
          "zh": {
            "action": "核算-48V后备电池续航"
          }
        }
      },
      {
        "order": 6,
        "toolId": "generator-fuel-runtime-calculator",
        "translations": {
          "en": {
            "action": "Plan generator fuel and emergency runtime"
          },
          "zh": {
            "action": "规划油机用油与应急续航"
          }
        }
      },
      {
        "order": 7,
        "toolId": "telecom-solar-battery-sizing-calculator",
        "translations": {
          "en": {
            "action": "Size solar generation and storage"
          },
          "zh": {
            "action": "配置光伏发电与储能"
          }
        }
      },
      {
        "order": 8,
        "toolId": "pue-data-center-energy-efficiency",
        "translations": {
          "en": {
            "action": "Analyze facility energy efficiency and optimization"
          },
          "zh": {
            "action": "分析设施能效与优化空间"
          }
        }
      }
    ]
  },
  {
    "id": "data-center-critical-power-cooling",
    "schemaVersion": "2.1.0",
    "status": "active",
    "domain": "power-datacenter",
    "primary": true,
    "translations": {
      "en": {
        "name": "Data Center Critical Power & Cooling Workflow",
        "description": "Move from rack load through UPS protection, generator/ATS ride-through, precision cooling, airflow containment and facility PUE as one critical-infrastructure planning sequence."
      },
      "zh": {
        "name": "数据中心关键电源与制冷工作流",
        "description": "从机架负载、UPS保障、油机/ATS切换跨越、精密制冷、气流组织到PUE能效，形成数据中心关键基础设施规划流程。"
      }
    },
    "steps": [
      {
        "order": 1,
        "toolId": "network-rack-power-cooling-calculator",
        "translations": {
          "en": {
            "action": "Establish rack IT power and heat load"
          },
          "zh": {
            "action": "确定机架IT功耗与发热负荷"
          }
        }
      },
      {
        "order": 2,
        "toolId": "ups-capacity-battery-runtime-calculator",
        "translations": {
          "en": {
            "action": "Size UPS capacity, redundancy and battery autonomy"
          },
          "zh": {
            "action": "配置UPS容量、冗余与电池续航"
          }
        }
      },
      {
        "order": 3,
        "toolId": "generator-ups-transfer-ride-through-planner",
        "translations": {
          "en": {
            "action": "Validate generator start, ATS transfer and UPS ride-through continuity"
          },
          "zh": {
            "action": "校验油机启动、ATS切换与UPS跨越供电连续性"
          }
        }
      },
      {
        "order": 4,
        "toolId": "data-center-cooling-load-calculator",
        "translations": {
          "en": {
            "action": "Size precision cooling and N+1 capacity"
          },
          "zh": {
            "action": "配置精密制冷容量与N+1冗余"
          }
        }
      },
      {
        "order": 5,
        "toolId": "data-center-airflow-containment-planner",
        "translations": {
          "en": {
            "action": "Plan rack airflow, aisle containment and N+1 delivery"
          },
          "zh": {
            "action": "规划机柜气流、冷热通道封闭与N+1送风"
          }
        }
      },
      {
        "order": 6,
        "toolId": "pue-data-center-energy-efficiency",
        "translations": {
          "en": {
            "action": "Analyze facility PUE and energy overhead"
          },
          "zh": {
            "action": "分析设施PUE与能源开销"
          }
        }
      }
    ]
  },
  {
    "id": "access-transport-optimization",
    "schemaVersion": "2.1.0",
    "status": "active",
    "domain": "transport",
    "primary": true,
    "translations": {
      "en": {
        "name": "Access & Transport Capacity Optimization Workflow",
        "description": "Plan protected OLT dual uplinks and transport/MSE capacity, then analyze ring protection-state bottlenecks and optimization options."
      },
      "zh": {
        "name": "接入与传输容量优化工作流",
        "description": "先规划OLT双上联、传输波道与MSE资源，再分析传输环保护倒换后的瓶颈和优化方案。"
      }
    },
    "steps": [
      {
        "order": 1,
        "toolId": "olt-dual-uplink-transport-mse-planner",
        "translations": {
          "en": {
            "action": "Size OLT dual uplinks, transport channels and MSE ports"
          },
          "zh": {
            "action": "规划OLT双上联、传输波道与MSE端口"
          }
        }
      },
      {
        "order": 2,
        "toolId": "transmission-ring-optimization-risk-analyzer",
        "translations": {
          "en": {
            "action": "Simulate N-1 ring failures and optimize protection-state capacity"
          },
          "zh": {
            "action": "模拟N-1环网故障并优化保护态容量"
          }
        }
      }
    ]
  },
  {
    "id": "data-center-network-fabric-planning",
    "schemaVersion": "2.1.0",
    "status": "active",
    "domain": "switching",
    "primary": true,
    "translations": {
      "en": {
        "name": "Data Center Network Fabric Planning Workflow",
        "description": "Move from traffic sizing through switch uplinks, fabric convergence, optics and implementation planning for a data center network."
      },
      "zh": {
        "name": "数据中心网络 Fabric 规划工作流",
        "description": "从业务带宽、交换机上联、Fabric 收敛、光模块到实施变更，形成数据中心网络容量设计闭环。"
      }
    },
    "steps": [
      {
        "order": 1,
        "toolId": "bandwidth-calculator",
        "translations": {
          "en": {
            "action": "Estimate application and transfer demand"
          },
          "zh": {
            "action": "估算业务与传输带宽需求"
          }
        }
      },
      {
        "order": 2,
        "toolId": "switch-uplink-oversubscription-calculator",
        "translations": {
          "en": {
            "action": "Size per-switch uplinks and oversubscription"
          },
          "zh": {
            "action": "规划单台交换机上联与超售"
          }
        }
      },
      {
        "order": 3,
        "toolId": "data-center-network-convergence-fabric-capacity-planner",
        "translations": {
          "en": {
            "action": "Validate fabric convergence, N-1 and traffic direction"
          },
          "zh": {
            "action": "验证 Fabric 收敛、N-1 与流量方向"
          }
        }
      },
      {
        "order": 4,
        "toolId": "sfp-qsfp-compatibility-calculator",
        "translations": {
          "en": {
            "action": "Validate optics and interface compatibility"
          },
          "zh": {
            "action": "核验光模块与接口兼容性"
          }
        }
      },
      {
        "order": 5,
        "toolId": "network-change-planner-mop-generator",
        "translations": {
          "en": {
            "action": "Turn the approved design into a change plan and MOP"
          },
          "zh": {
            "action": "将确认后的设计转成变更计划与 MOP"
          }
        }
      }
    ]
  }
]
